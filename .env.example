# Public site URL (used for SEO metadata, sitemap and canonical links)
NEXT_PUBLIC_SITE_URL=https://www.elonhardware.in

# ---- Database & uploads ----
# SQLite database file. Created and filled with the starter catalogue automatically on first run.
DATABASE_PATH=./data/elon.db
# Where admin-uploaded images are stored (served at /uploads/...)
UPLOAD_DIR=./data/uploads

# ---- Admin panel (/admin) ----
# Set a strong password to enable the admin panel. Leave empty to disable it.
ADMIN_PASSWORD=
# Optional: secret used to sign admin sessions (defaults to a hash of ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
# Only for testing over plain http (no HTTPS) in production mode:
# ADMIN_INSECURE_COOKIE=true

# ---- Enquiry notifications (optional, recommended) ----
# Every enquiry is always saved in the database. Additionally:
# when SMTP_HOST is set, each enquiry is emailed to ENQUIRY_TO.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ENQUIRY_FROM="ELON HARDWARE Website <no-reply@elonhardware.in>"
ENQUIRY_TO=sales@elonhardware.in

# Optional: also POST each enquiry as JSON to a webhook (Google Apps Script, Zapier, CRM, Slack…)
ENQUIRY_WEBHOOK_URL=
